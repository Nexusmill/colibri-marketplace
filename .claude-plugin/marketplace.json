{
  "$schema": "https://code.claude.com/schemas/marketplace.json",
  "name": "colibri-marketplace",
  "description": "Nexusmill plugin marketplace.",
  "owner": {
    "name": "Nexusmill"
  },
  "plugins": [
    {
      "name": "colibri-review",
      "source": "./plugins/colibri-review",
