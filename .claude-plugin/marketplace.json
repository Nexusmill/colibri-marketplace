      "version": "0.2.0",
      "author": {
        "name": "Nexusmill"
      },
      "license": "MIT",
      "keywords": [
        "code-review",
        "debugging",
        "code-quality",
        "audit",
        "security-review",
        "static-analysis",
        "spec-conformance",
        "remediation-plan"
      ]
    }
  ]
}
